<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates are downloaded from GitHub and handed to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Automatic updates (off by default): lets Android 12 and later install one without asking. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The settings pages that let it install apps, so it can tell which ones the device has. -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application>
        <receiver
            android:name="it.allard.etincelle.core.ui.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
