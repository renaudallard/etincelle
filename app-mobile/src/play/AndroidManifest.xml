<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play updates this build itself: nothing of the in-app updater is left in it. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />

    <application>
        <receiver
            android:name="it.allard.etincelle.core.ui.InstallResultReceiver"
            tools:node="remove" />
    </application>
</manifest>
