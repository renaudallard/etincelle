<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The home screen row and Watch Next (TvHome), kept fresh by a job that survives reboots. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The phone's remote control stays reachable through the screensaver (RemoteKeepAliveService); a
         connected-device service needs one of the network permissions. Coming back from behind the
         screensaver to play what the phone sent takes "display over other apps", granted by the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.live_tv"
        android:required="false" />

    <application
        android:name=".EtincelleTvApp"
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Etincelle">

        <!-- Every configuration change is taken in place (Compose redraws): a recreation would restart
             what plays from where it was opened, as when a keyboard or gamepad connects. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|mcc|mnc"
            android:theme="@style/Theme.Etincelle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Deep links to a show: etincelle://series|program|channel/{id} (e.g. from multistream). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="etincelle" android:host="series" />
                <data android:scheme="etincelle" android:host="program" />
                <data android:scheme="etincelle" android:host="channel" />
            </intent-filter>
        </activity>

        <service
            android:name=".RemoteKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".TvHomeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Molotov's channels in the system's TV guide, played by etincelle itself (TvLive). -->
        <service
            android:name=".TvLiveInputService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/tv_input" />
        </service>

        <activity
            android:name=".TvLiveSetupActivity"
            android:exported="true"
            android:theme="@style/Theme.Etincelle" />

        <receiver
            android:name=".TvHomeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
